{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZHOUKAILIAN/codex-agent-team/schemas/team.schema.json",
  "title": "Codex Agent Team Recipe",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "parent_responsibility",
    "stages",
    "completion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "use_when": { "type": "string" },
    "parent_responsibility": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "mode", "objective"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "agent": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "parallel_group": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "mode": { "enum": ["read-only", "write"] },
          "objective": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "completion": {
      "type": "object",
      "required": ["require_all_stages", "require_parent_synthesis"],
      "properties": {
        "require_all_stages": { "type": "boolean" },
        "require_parent_synthesis": { "type": "boolean" },
        "allowed_verdicts": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

